[product]
	name = Package2Folder
[unity]
	installsRoot = D:/Programming/Unity/Installs
	hub = C:/Program Files/Unity Hub/Unity Hub.exe
[git]
	devBranch = develop
	mainBranch = master
	releasePrefix = release/
[plugin]
	folder = Packages/net.codestage.package2folder
	masterProject = Tests/Unity~
	sourceFolder = .
	versionFile = package.json
	packageJson = package.json
	changelog = CHANGELOG.md
[store]
	method = CodeStage.PackageToFolder.Service.AssetStorePublisher.Upload
	tempExportPrefix = p2f_upload
	listing = Package2Folder|64829
	slot = Tests/Unity~
[artifacts]
	dir = ../Releases
	oldDir = ../Releases/Old
	pattern = {version}.unitypackage
